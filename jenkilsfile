pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/https://github.com/MrAryanShah/ai-mental-health-cdss/python-project.git'
            }
        }

        stage('Build') {
            steps {
                sh 'python3 --version'
                sh 'pip3 install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                sh 'python3 -m unittest discover'
            }
        }

    }

    post {

        success {
            echo 'Build Successful!'
        }

        failure {
            echo 'Build Failed!'
        }

        always {
            echo 'Pipeline Execution Completed.'
        }

    }
}
