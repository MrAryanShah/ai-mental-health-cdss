pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/MrAryanShah/ai-mental-health-cdss.git'
            }
        }

        stage('Build') {
            steps {
                dir('python-project') {
                    sh 'python3 --version'
                    sh 'pip3 install -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                dir('python-project') {
                    sh 'python3 -m unittest discover'
                }
            }
        }
    }

    post {
        success {
            echo 'Build Successful!'
        }

        failure {
            echo 'Build Failed!'
        }

        always {
            echo 'Pipeline Execution Completed.'
        }
    }
}
